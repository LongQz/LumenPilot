# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="LumenPilot"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY=""
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen4-max
LLM_MODELS=qwen4-max,qwen3.7-plus

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=12000
SESSION_NAMING_ENABLED=true

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Long-term memory on Alibaba Cloud Bailian
LONG_TERM_MEMORY_MODEL=qwen3.7-plus
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-v3
LONG_TERM_MEMORY_EMBEDDING_DIMS=1024
LONG_TERM_MEMORY_COLLECTION_NAME=lumafeed_memory

# 运营知识向量 RAG（与 mem0 长期记忆使用独立向量表）
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_RAG_EMBEDDING_MODEL=text-embedding-v3
KNOWLEDGE_RAG_EMBEDDING_DIMS=1024
KNOWLEDGE_RAG_TABLE=lumafeed_operations_knowledge
KNOWLEDGE_RAG_MIN_SCORE=0.2

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# LangGraph 架构图：每次创建 Agent 时导出 Mermaid 和 PNG
GRAPH_DIAGRAM_ENABLED=true
GRAPH_DIAGRAM_DIR=docs/generated
GRAPH_DIAGRAM_RENDER_PNG=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# LumaFeed integration
LUMAFEED_API_BASE_URL=http://127.0.0.1:8081
LUMAFEED_AGENT_TOKEN=luma-demo-token
LUMAFEED_REQUEST_TIMEOUT=15

# LumenPilot accounts live in the LumaFeed MySQL database (separate tables).
AUTH_MYSQL_HOST=127.0.0.1
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_DB=lumafeed
AUTH_MYSQL_USER=root
AUTH_MYSQL_PASSWORD=123456
